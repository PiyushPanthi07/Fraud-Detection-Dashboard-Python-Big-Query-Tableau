      <aliases enabled='yes' />
      <column caption='Fraud Cities' datatype='string' name='[Calculation_5203487212028506115]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fraud_flag] = TRUE THEN [billing_city] END' />
      </column>
      <column caption='Chargeback Ratio' datatype='real' name='[Calculation_816488593172357120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [chargeback_flag] = TRUE THEN 1 ELSE 0 END) &#10;/ COUNT([order_id])' />
      </column>
      <column caption='Refund Rate' datatype='real' name='[Calculation_816488593173581827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [refund_flag] = TRUE THEN 1 ELSE 0 END) &#10;/ COUNT([order_id])' />
      </column>
      <column caption='Decline Rate' datatype='real' name='[Calculation_816488593176031236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([decline_reason]) THEN 1 ELSE 0 END) &#10;/ COUNT([order_id])' />
      </column>
      <column caption='High-Risk Customers' datatype='integer' name='[Calculation_816488593176555525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [fraud_flag] = TRUE &#10;       OR [chargeback_flag] = TRUE &#10;       OR [refund_flag] = TRUE &#10;       OR [blacklist_flag] = TRUE&#10;    THEN [customer_id] END&#10;)' />
      </column>
      <column caption='Header' datatype='string' name='[Calculation_816488593188032518]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Fradu Detection Dashboard&quot;' />
      </column>
      <column caption='Fraud Orders' datatype='integer' name='[Calculation_816488593192689671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [fraud_flag] = TRUE THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Fraud Rate %' datatype='real' name='[Calculation_816488593193013256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [fraud_flag] = TRUE THEN 1 ELSE 0 END) / COUNT([order_id])' />
      </column>
